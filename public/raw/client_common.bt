string read_client_id(uint id)
{
    return id_to_code(id,-1);
}

typedef uint _client_id <read=read_client_id,comment="BETA. This is not editable - DO NOT TRY AND EDIT!">;

/***********
 * STRUCTS *
 ***********/
typedef struct {
    shopByteCode    shopCode;
    byte    unknown; 
    int     totalSize<comment="Total size of this structure -10 bytes">;    
    int     startPosition<comment="Start position of this structure tree">;
    int     blocks;
    int     size;
    count = ((header.size-64-8)/4);
    struct_item_type = shopCode;
} head_struct;

typedef struct {
    int     blocks;
    int     size;
} head_char_struct;

typedef struct {
    if(NAMES_ONLY == 0) {
    int         index;
    if(ENABLE_SERVER_CODE == 1) {
    _client_id  id;
    } else {
    uint  id;
    }
    } else {
    FSkip(8);
    }
    _str_code   name;
    if(NAMES_ONLY == 0) {
    struct {
        ubyte        index<format=decimal, comment="Same as Resource.dat">;
        ModelType   type<comment="Same as Resource.dat">;
        RaceGender  race_gender<comment="NOT the same as Resource.dat">;
    } model_id<open=true>;
    int         icon_id;
    }
} _base<open=true>;

typedef struct  {
    struct {
        float       x;
        float       y;
        float       z;
    } min;
    struct {
        float       x;
        float       y;
        float       z;
    } max;
} Coords;

typedef struct {
    byte     basic;
    byte     expert;
    byte     elite;
    byte     master;
} SkillCategory;

typedef struct {
    byte        melee;
    byte        range;
    byte        unit;
    byte        force;
    byte        shield;
    byte        defense;
} CombatLimits;

typedef struct {
    byte        weaponAndShield;
    byte        armor;
    byte        ammo;
} CraftLimits;

typedef struct {
    SkillCategory       holy; 
    SkillCategory       dark;
    SkillCategory       fire;
    SkillCategory       water;
    SkillCategory       earth;
    SkillCategory       wind;
} ForceLimits;

typedef struct {
    SkillCategory       closeRange;
    SkillCategory       longRange;
} SkillLimits;

typedef struct {
    byte     basic;
    byte     expert;
    byte     elite;
    byte     master;
} MaximumPoints;

typedef struct {
    int16       fire;
    int16       water;
    int16       soil;
    int16       wind;
} elements;


typedef struct {
    char       fire;
    char       water;
    char       soil;
    char       wind;
} elements_bit;

typedef struct
{
    abaility_types      type;
} ability_stats;

typedef struct
{
    float               value;
} ability_types;

typedef struct {
    int   blocks;
    int   size;
} UNKNOWNHEADER;

typedef struct {
    Skill_Type      type;
    byte            unknown<hidden=true>;
    byte            points;
} Combat_Skills;

typedef struct(int headerSize) {
    shopByteCode    itemType;
    moneytype       currencyType;
    int16           skip<hidden=true>;
    int             sellPrice;
    int             pvpPoint;
    int             unknown;
    int             unknown;
    if(header.size > headerSize)  {
        int             unknown;
    }
    int             storagePoint;
} Money_Info;

struct rev_shop
{
    local int start_value;
    start_value = startof(class_name2)+32+4+41+199;

    shop_code     shop_id;
    FSeek(start_value+36+(i*4));
    int             item_id;
    i += 4;

    FSeek(start_value+i);
};

