/*************
 * FUNCTIONS *
 *************/
string read_client_id(uint id)
{
    return id_to_code(id);
}

string readCivil(Civil civil)
{
    char race[64];
    if(Strcmp(civil, "11000") == 0)
    {
        return SPrintf(race, "%s", "bell");
    } 
    else if(Strcmp(civil, "00110") == 0) 
    {
        return SPrintf(race, "%s", "cora");
    }
    else if(Strcmp(civil, "00001") == 0) 
    {
        return SPrintf(race, "%s", "acc");
    } 
    else if(Strcmp(civil, "11111") == 0) 
    {
        return SPrintf(race, "%s", "all");
    }
    else if(Strcmp(civil, "11110") == 0) 
    {
        return SPrintf(race, "%s", "bell & cora");
    }
    else
    {
        return civil;
    }
} 

void writeCivil(Civil &civil, string s)
{
    if(Strcmp(s, "bell") == 0)
    {  
        SScanf("11000", "%s", civil);
    } 
    else if(Strcmp(s, "cora") == 0) 
    {
        SScanf("00110", "%s", civil);
    }
    else if(Strcmp(s, "acc") == 0) 
    {
        SScanf("00001", "%s", civil);
    } 
    else if(Strcmp(s, "all") == 0) 
    {
        SScanf("11111", "%s", civil);
    }
    else if(Strcmp(s, "bell & cora") == 0) 
    {
        SScanf("11110", "%s", civil);
    }
} 


string readSkillCivil(SkillCivil skillcivil)
{
    char race[64];
    if(Strcmp(skillcivil, "110000") == 0)
    {
        return SPrintf(race, "%s", "bell");
    } 
    else if(Strcmp(skillcivil, "001100") == 0) 
    {
        return SPrintf(race, "%s", "cora");
    }
    else if(Strcmp(skillcivil, "000010") == 0) 
    {
        return SPrintf(race, "%s", "acc");
    } 
    else if(Strcmp(skillcivil, "111110") == 0) 
    {
        return SPrintf(race, "%s", "all");
    }
    else
    {
        return skillcivil;
    }
} 

void writeSkillCivil(SkillCivil &skillcivil, string s)
{
    if(Strcmp(s, "bell") == 0)
    {  
        SScanf("110000", "%s", skillcivil);
    } 
    else if(Strcmp(s, "cora") == 0) 
    {
        SScanf("001100", "%s", skillcivil);
    }
    else if(Strcmp(s, "acc") == 0) 
    {
        SScanf("000010", "%s", skillcivil);
    } 
    else if(Strcmp(s, "all") == 0) 
    {
        SScanf("111110", "%s", skillcivil);
    }
} 
