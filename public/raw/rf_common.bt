typedef struct {
        Currency_Type   currencyType<comment="Set type of currency that is used to purchase this item">;
        int             sellPrice<comment="Set the amount of (GOLD/MONEY) the user recieves when SELLING this item">;
        int             pvpPoint<comment="Set the amount of PVP POINTS required to BUY this item">; 
    if(exists(header.is223f)) {
        int             goldPoint<comment="Set the amount of GOLD POINTS (gold weapons etc) required to BUY this item">;
        }
    if(exists(header.is223f)) {
        int             killPoint; 
        int             processPoint;
        } else {
        int             processPoint;        
        int             killPoint; 
        }
        int             storagePrice<comment="Set the amount it costs to Store this item">;
} MoneyInfo_7;

