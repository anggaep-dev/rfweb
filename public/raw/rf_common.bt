struct HEADER 
{
    int 	blocks;
	int	    columns;
	int	    size;

    if(exists(vG4) && size >= vG4) {
        Printf("----------------------------------\n");
        Printf("Loaded G4 specific vriables\n");
        Printf("----------------------------------\n");
        local int isG4 = 1;
    }

    if(exists(v215) && size >= v215) {
        Printf("----------------------------------\n");
        Printf("Loaded 215 specific vriables\n");
        Printf("----------------------------------\n");
        local int is215 = 1;
    }

    if(exists(v216) && size >= v216) {
        Printf("----------------------------------\n");
        Printf("Loaded 2.1.6 specific vriables\n");
        Printf("----------------------------------\n");
        local int is216 = 1;
    }

    if(exists(v223) && size >= v223) {
        Printf("----------------------------------\n");
        Printf("Loaded 2.2.3 specific variables\n");
        Printf("----------------------------------\n");
        local int is223 = 1;
    }

    if(exists(v223f) && size >= v223f) {
        Printf("----------------------------------\n");
        Printf("Loaded 2.2.3 final specific variables\n");
        Printf("----------------------------------\n");
        local int is223f = 1;
    }

};

