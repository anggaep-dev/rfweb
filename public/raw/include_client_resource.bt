#define MAX_CHAR_TYPE				6
#define CTI_AVATAR					0xF				// 아바타를 제외한 나머지 값들은 서버측과 맞춘것임
#define CTI_PLAYER					0			
#define CTI_MONSTER					1
#define CTI_NPC						2
#define CTI_ANIMUS					3
#define CTI_GUARD_TOWER				4
#define CTI_UNIT					0x5
#define CTI_OBSERVER				0x6
#define CTI_DUMMY					0x7

// Resource Data List ID ( RLI_ )
#define MAX_RES_DATA_LIST        9
#define RLI_PLAYER                        0
#define RLI_MONSTER                        1
#define RLI_ANIMUS                        2
#define RLI_GUARD_TOWER                3
#define RLI_NPC                                4
#define RLI_ITEM                        5
#define RLI_UNIT                        6
#define RLI_SKILL                        7
#define RLI_FORCE                        8


