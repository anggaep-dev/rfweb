enum <uint16> RaceGender {
    cBell_Armor_Male = 0x00,
    cBell_Default_Male = 0x05,
    cBell_Armor_Female = 0x10,
    cBell_Default_Female = 0x15,
    cCora_Armor_Male = 0x20,
    cCora_Default_Male = 0x25,
    cCora_Armor_Female = 0x30,
    cCora_Default_Female = 0x35,
    cAccretia_Armor_Robot = 0x40,
    cAccretia_Default_Robot = 0x45,
   
    cBell_Armor_Military = 0x70,
   
    cCora_Armor_Military = 0x80
};

enum <ubyte> ModelType {
    cModel_Helmet = 0x00,
    cModel_Face = 0x01,
    cModel_Upper = 0x02,
    cModel_Lower = 0x03,
    cModel_Gauntlet = 0x04,
    cModel_Shoes = 0x05
};

typedef struct MODEL_ID {
        ubyte      index<format=decimal, comment="e.g. ..._XXX.MSH, where XXX is this value. [e.g. 196 = C4 = This value]">;
        ModelType type<comment="Same as the value in Item.dat">;
        RaceGender race_gender<comment="Same as the value in Resource.dat">;
};

struct PLAYER_BONE {
    RACEGENDER  race_gender;
    char        bone_path[128];
    char        bn_filename[64];
    char        bbx_filename[64];
};

struct GENERAL_BONE {
    int         index;
    char        bone_path[128];
    char        bn_filename[64];
    char        bbx_filename[64];
};

struct  PLAYER_MESH {
    MODEL_ID    model_id<open=true>;
    RACEGENDER  boneID;
    char        mesh_path[128];
    char        mesh_filename[64];
    char        tex_path[128];
};

struct  GENERAL_MESH {
    MODEL_ID    model_id<open=true>;
    int         boneID;
    char        mesh_path[128];
    char        mesh_filename[64];
    char        tex_path[128];
};

struct  PLAYER_ANI {
    ANI_TYPE    type;
    int16       id;
    byte        unknown<hidden=true>;
    RACEGENDER  race_gender;
    char        ani_path[128];
    char        ani_filename[64];
    int         total_active_effects;
    int         effect[10];
};

enum <int> iAniAction {
    iAction_Default = 0,
    iAction_Equip = 1,
    iAction_UnEquip = 2,
    iAction_Attack = 3,
    iAction_Use = 4,
    iAction_UnUse = 5
};

struct  GENERAL_ANI {
    /*iAniAction  actionType;
    ubyte       unknown;
    ubyte       unknown;
    ubyte       unknown;*/

    DWORD       id;

    local int   meshID = (id & 0x0FFFF000) >> (3*4);
    local int   effectType = (id & 0x00000FF0) >> (1*4);
    local iAniAction   animationID = (id & 0x0000000F);

    int         set_number;

    char        ani_path[128];
    char        ani_filename[64];

    int         total_active_effects;
    int         effect[10];
};